# Copy to .env.production. Never commit populated secrets.
# Use a long URL-safe database password (for example random hexadecimal).
POSTGRES_PASSWORD=
NYCTR_PUBLIC_URL=https://nyctr.example.com
# Optional: a second HTTPS origin for the member portal, e.g. https://blocked.example.com.
# Your reverse proxy must serve both names and your identity provider must allow
# <portal>/api/auth/oidc/callback. See docs/security-model.md, "Two addresses".
NYCTR_PORTAL_URL=
# Required: exact reverse-proxy peer IPs as seen by the application, comma-separated.
# Example only: 10.42.0.10,10.42.0.11. Never use * or a shared client/container subnet.
# The proxy must write the address it saw as the last X-Forwarded-For entry; see deploy/README.md.
# This list was called FORWARDED_ALLOW_IPS. That name is still read for this release when
# NYCTR_TRUSTED_PROXIES is empty, with a warning; move the value here and remove the old name.
NYCTR_TRUSTED_PROXIES=
# How many of your own proxies a request passes: which entry, from the right, Nyctr reads.
NYCTR_PROXY_HOPS=1
NYCTR_BOOTSTRAP_ADMIN_EMAIL=
# At least 12 characters; remove bootstrap values after initial provisioning.
NYCTR_BOOTSTRAP_ADMIN_PASSWORD=
NYCTR_LOCAL_LOGIN_ENABLED=true

# Optional OIDC. Callback: https://nyctr.example.com/api/auth/oidc/callback
NYCTR_OIDC_ISSUER=
NYCTR_OIDC_CLIENT_ID=
NYCTR_OIDC_CLIENT_SECRET=
NYCTR_OIDC_ADMIN_GROUPS=
NYCTR_OIDC_ALLOWED_GROUPS=
NYCTR_OIDC_GROUPS_CLAIM=groups

# Optional read-only collection. References below are entered in the UI by name.
NYCTR_CONNECTOR_HOSTS=
NYCTR_CONNECTOR_SECRET_UNIFI=
NYCTR_CONNECTOR_SECRET_NEXTDNS=
# Proxmox API token in the form user@realm!name=value. Give it a read-only role.
NYCTR_CONNECTOR_SECRET_PROXMOX=
# Pi-hole web password or, better, an application password made for Nyctr.
NYCTR_CONNECTOR_SECRET_PIHOLE=

# Integrations Nyctr may change, comma separated: nextdns, unifi_network, or
# nextdns,unifi_network for both. Only integrations that can change their source
# are accepted. Leave empty for read-only.
NYCTR_PROVIDER_WRITES=
# Starting interval for scheduled collection (60 to 86400 seconds), used until an
# administrator saves a schedule. 0 leaves the product default of
# 15 minutes; it does not turn the schedule off. The guest cut-off rule and
# lock-out act at every collection.
NYCTR_COLLECT_INTERVAL_SECONDS=0

# Optional shared secret (32+ characters) for /api/hooks/collect, so UniFi can ask Nyctr to collect now.
NYCTR_NUDGE_TOKEN=

# Optional assistant: an OpenAI-compatible chat endpoint, for example a LiteLLM proxy.
NYCTR_AI_BASE_URL=
NYCTR_AI_MODEL=
NYCTR_AI_API_KEY=
# How calls to that endpoint are traced: off (no trace header, the default), standard, proxy or
# proxy_body. See docs/model.md.
NYCTR_AI_TRACE=off

# An administrator can also connect the model in the Console (Setup, This installation).
# NYCTR_MODEL_HOSTS: comma-separated servers an endpoint may be on, besides the one in
# NYCTR_AI_BASE_URL. A bare name allows HTTPS on port 443 only; write any other port, or plain
# HTTP, in full: https://name:8443, http://name:4000. Empty allows no other server.
# The Console names a key by its variable, which must start with NYCTR_MODEL_SECRET_; add one
# line here and in the Compose file per key.
NYCTR_MODEL_HOSTS=
NYCTR_MODEL_SECRET_MAIN=
