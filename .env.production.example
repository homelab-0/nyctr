# Copy to .env.production. Never commit populated secrets.
# Use a long URL-safe database password (for example random hexadecimal).
POSTGRES_PASSWORD=
NYCTR_PUBLIC_URL=https://nyctr.example.com
# Required: exact reverse-proxy peer IPs as seen by the application, comma-separated.
# Example only: 10.42.0.10,10.42.0.11. Never use * or a shared client/container subnet.
# The proxy must replace untrusted forwarded headers; see deploy/README.md.
FORWARDED_ALLOW_IPS=
NYCTR_BOOTSTRAP_ADMIN_EMAIL=
# At least 12 characters; remove bootstrap values after initial provisioning.
NYCTR_BOOTSTRAP_ADMIN_PASSWORD=
NYCTR_LOCAL_LOGIN_ENABLED=true

# Optional OIDC. Callback: https://nyctr.example.com/api/auth/oidc/callback
NYCTR_OIDC_ISSUER=
NYCTR_OIDC_CLIENT_ID=
NYCTR_OIDC_CLIENT_SECRET=
NYCTR_OIDC_ADMIN_GROUPS=
NYCTR_OIDC_ALLOWED_GROUPS=
NYCTR_OIDC_GROUPS_CLAIM=groups

# Optional read-only collection. References below are entered in the UI by name.
NYCTR_CONNECTOR_HOSTS=
NYCTR_CONNECTOR_SECRET_UNIFI=
NYCTR_CONNECTOR_SECRET_NEXTDNS=
# Proxmox API token in the form user@realm!name=value. Give it a read-only role.
NYCTR_CONNECTOR_SECRET_PROXMOX=
# Pi-hole web password or, better, an application password made for Nyctr.
NYCTR_CONNECTOR_SECRET_PIHOLE=

# Integrations Nyctr may change, comma separated: nextdns, unifi_network, or
# nextdns,unifi_network for both. Only integrations that can change their source
# are accepted. Leave empty for read-only.
NYCTR_PROVIDER_WRITES=
# Seconds between automatic collections (60 to 86400). 0 collects only on request.
NYCTR_COLLECT_INTERVAL_SECONDS=0

# Optional shared secret (32+ characters) for /api/hooks/collect, so UniFi can ask Nyctr to collect now.
NYCTR_NUDGE_TOKEN=

# Optional assistant: an OpenAI-compatible chat endpoint, for example a LiteLLM proxy.
NYCTR_AI_BASE_URL=
NYCTR_AI_MODEL=
NYCTR_AI_API_KEY=
